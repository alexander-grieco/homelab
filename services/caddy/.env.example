# Cloudflare API token for the certificate (DNS challenge):
# Zone > Zone > Read and Zone > DNS > Edit, for this domain only
CF_API_TOKEN=
TS_TAILNET=
# Services are served at <name>.<DOMAIN>. If this has more than two parts
# (e.g. homelab.grieco.tech), change {labels.2} in the Caddyfile to {labels.3}.
DOMAIN=
