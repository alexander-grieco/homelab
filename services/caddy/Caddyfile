# https://<name>.<DOMAIN> -> https://<name>.<tailnet>.ts.net (Tailscale Service
# svc:<name>). New Services need no change here and no DNS change.
# Caddy is itself the Tailscale Service svc:caddy: Tailscale forwards raw TCP
# from the Service's port 443 to 127.0.0.1:8443, and Caddy does the TLS with
# the wildcard certificate.

{
  default_bind 127.0.0.1 # never listen on the LAN or tailnet directly
  https_port 8443
  http_port 8080
  auto_https disable_redirects # nothing reaches port 80
}

*.{$DOMAIN} {
  tls {
    dns cloudflare {env.CF_API_TOKEN}
    # Check the challenge record via public DNS. Caddy shares the host's
    # network, where DNS goes through Tailscale (MagicDNS), and its check
    # timed out there.
    propagation_timeout 45m
  }

   # caddy.<DOMAIN> would proxy to svc:caddy, i.e. back to this Caddy, forever.
   @self host caddy.{$DOMAIN}
   respond @self 404

   # {labels.N} counts host labels from the right. For DOMAIN=hl.grieco.tech:
   # tech=0, grieco=1, hl=2, <name>=3.
   # Placeholder upstreams can't be URLs and must include a port.
   reverse_proxy {labels.2}.{$TS_TAILNET}:443 {
     transport http {
       tls # Services serve HTTPS with their ts.net certificate
       resolvers 100.100.100.100 # MagicDNS, for *.ts.net names
     }
   }
}
