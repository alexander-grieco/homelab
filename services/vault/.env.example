#COMPOSE_PROJECT_NAME= # Optional: only use when running multiple deployments on the same infrastructure.
# Service Configuration
SERVICE=vault

# Pin to a version once running: docker exec app-vault vault version
IMAGE_URL=docker.io/hashicorp/vault:<REPLACE_ME>

# Tailscale Configuration
# Auth key from https://login.tailscale.com/admin/settings/keys (no tags needed).
TS_AUTHKEY=
# Your tailnet's domain, from https://login.tailscale.com/admin/dns ("Tailnet name"), e.g. tail1234.ts.net
TS_DOMAIN=
